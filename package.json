		"svelte": "^5.43.8",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.9.3",
		"vite": "^7.2.2"
	},
	"dependencies": {
		"@editorjs/editorjs": "^2.31.0",
		"@editorjs/header": "^2.8.8",
		"@editorjs/list": "^2.0.9",
		"@editorjs/paragraph": "^2.11.7",
